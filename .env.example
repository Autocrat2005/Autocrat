# ─────────────────────────────────────────────────────────────────────
# Autocrat environment — copy to `.env` and fill in. `.env` is gitignored.
# Never put real values in this file or in nexus_config.yaml.
# ─────────────────────────────────────────────────────────────────────

# ── Control plane ──
# High-entropy token for the HUD / REST / WebSocket. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOCRAT_AUTH_TOKEN=
# Comma-separated origins allowed to call the API from a browser
AUTOCRAT_CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000,http://localhost:5173

# ── Runtime ──
# dry_run = external/financial actions are simulated, never sent. live = real.
RUN_MODE=dry_run
# Profile: core (VM, no desktop plugins) | desk (laptop) | full (both, dev)
AUTOCRAT_PROFILE=full
# Extra plugin directories (comma-separated, relative to this repo or absolute)
AUTOCRAT_PLUGIN_PATHS=../autocrat-revenue-plugins/plugins
# SQLite store location (WAL mode)
AUTOCRAT_DB_PATH=.autocrat/autocrat.db
# Set to 0 to skip loading the sentence-transformer intent brain (e.g. on the core VM)
AUTOCRAT_BRAIN=1

# ── Telegram (alerts + approvals) ──
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user IDs allowed to command/approve (Yash, Parth). Get yours from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=
# Optional: restrict to these chat IDs too (e.g. your private founders group). Alerts go here.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── WhatsApp Web alerts (internal only: your numbers + your group) ──
# Sender = whichever account you log into the alert profile (use a spare number):
#   python -m nexus.integrations.whatsapp_alerts login   (then: ... test)
WHATSAPP_ALERTS_ENABLED=0
# Your numbers with country code, comma-separated (e.g. +9198xxxxxxxx)
WHATSAPP_ALERT_NUMBERS=
# Exact group names as shown in WhatsApp (the sender account must be a member)
WHATSAPP_ALERT_GROUPS=
WHATSAPP_ALERT_HEADLESS=1
WHATSAPP_ALERT_MAX_PER_HOUR=12

# ── WhatsApp closer (inbound replies in your voice, same WhatsApp Web session) ──
# Starts in RUN_MODE=dry_run: drafts are sent to you as alerts, nothing goes to prospects.
WHATSAPP_CLOSER_ENABLED=0
# Name the closer writes as
AUTOCRAT_CLOSER_NAME=Yash
AUTOCRAT_VOICE_FILE=../autocrat-revenue-plugins/config/voice.md
# Only reply to unsaved numbers + existing leads (keep 1 on a personal account)
WHATSAPP_CLOSER_ONLY_UNSAVED=1
# Saved contacts to allow anyway / chats to always ignore (comma-separated chat names)
WHATSAPP_CLOSER_ALLOW=
WHATSAPP_CLOSER_IGNORE=
WHATSAPP_CLOSER_POLL_SECONDS=40
WHATSAPP_CLOSER_MAX_PER_CHAT_HOUR=12
BOOKING_LINK=
DEPOSIT_LINK_USD=
DEPOSIT_LINK_INR=

# ── Email channel (openers + AI replies). Zoho: smtp.zoho.com:465 / imap.zoho.com
# (India data centre accounts: smtp.zoho.in / imap.zoho.in). Use an app password, not your login password.
EMAIL_ENABLED=0
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.zoho.com
EMAIL_SMTP_PORT=465
EMAIL_IMAP_HOST=imap.zoho.com
EMAIL_FROM_NAME=Yash
EMAIL_SIGNATURE=Yash
# 1 = send staged openers automatically (no tap). 0 = only send the ones you approve in Telegram.
EMAIL_AUTO_SEND=1
EMAIL_DAILY_CAP=20
EMAIL_SEND_HOURS=9-18
EMAIL_UTC_OFFSET_MINUTES=240
EMAIL_POLL_SECONDS=120

# ── LLM providers ──
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Optional: DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Lead sources ──
# Google Places API (New) key: console.cloud.google.com → enable "Places API (New)" → Credentials → API key
GOOGLE_MAPS_API_KEY=
APIFY_TOKEN=
X_BEARER_TOKEN=

# ── WhatsApp Cloud API, Coexistence (Phase 4) ──
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Deposits (Phase 3) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Payment-link base URLs for international clients (USD/GBP/AED)
INFINITY_PAYMENT_LINK_BASE=
WISE_PAYMENT_LINK_BASE=

# ── Demo hosting (Phase 3) ──
BASE_DOMAIN=
CLOUDFLARE_API_TOKEN=
# Physical postal address under the opt-out line (US cold email needs one: CAN-SPAM)
EMAIL_POSTAL_ADDRESS=
# Warm-up: the daily cap starts at EMAIL_DAILY_CAP and rises EMAIL_CAP_STEP per clean sending day (no bounces), up to EMAIL_CAP_MAX
EMAIL_CAP_MAX=40
EMAIL_CAP_STEP=3
# Follow-ups in the same thread when there's no reply: days after the opener, then after follow-up 1 (set EMAIL_FOLLOWUPS=0 to turn off)
EMAIL_FOLLOWUPS=1
EMAIL_FOLLOWUP_DAYS=3,4
# /wa in Telegram: country code added to numbers written without one (971 = UAE)
WA_LINKS_DEFAULT_CC=971
# WhatsApp Cloud API closer (OFF): answers people who message your business number first, free 24h window
WHATSAPP_CLOUD_ENABLED=0
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_GRAPH_VERSION=v23.0
# Booking calls fast: the closer offers two real times inside BOTH your hours and theirs, sends a calendar invite,
# and you get Telegram reminders 60 and 10 minutes before (they get one email 60 minutes before)
OWNER_AVAILABILITY=Mon-Sat 10-22
OWNER_UTC_OFFSET_MINUTES=330
MEETING_MINUTES=20
# Optional fixed link (your Google Meet / Zoom room). Empty = a free Jitsi room per lead
MEETING_LINK=
# Replies: scan the last N days of the inbox (read or unread); Zoho's sent folder name
EMAIL_SCAN_DAYS=3
EMAIL_SENT_FOLDER=Sent
# Quiet conversations: nudge after this many hours of silence (max 2 nudges)
EMAIL_NUDGE_HOURS=48
# 9am cash brief on Telegram (your timezone)
DAILY_BRIEF_HOUR=9

# ── Cash: you collect deposits yourself; one Telegram tap emails the request (invoice no. + how to pay)
# The closer never writes payment details. Leave DEPOSIT_LINK_* empty for this manual mode.
WISE_TAG=
# Optional pay-online link (Stripe / Razorpay / Wise payment link), listed first in the request
PAYMENT_LINK=
DEPOSIT_PCT=50
# Used when no price came up in the conversation (real estate builds default to 2500)
DEFAULT_DEAL_USD=1250
INVOICE_PREFIX=WR
# One friendly "did the invoice land?" email after this many hours; you get a red ping at twice that
PAYMENT_CHASE_HOURS=48

# ── Call desk (/calls): you dial by hand; Autocrat never calls anyone
# Cold numbers only from these markets (US = business lines, manual dialing). Hot replies: any market.
CALL_MARKETS=US
# Their local hours, Mon-Fri
CALL_HOURS=9-17
CALL_MAX_TRIES=3

# -- Brand, proof and bigger offers
EMAIL_COMPANY=Windrose Labs
# Your site: added to the sign-off only after a prospect has replied (never in cold first emails)
EMAIL_SITE=
# Optional: a range the reply-writer may quote for the 30-day MVP. Empty = it books a scoping call instead
MVP_PRICE_RANGE=
DEPOSIT_GUARANTEE=1
CARE_PLAN_USD=149
REFERRAL_REWARD_USD=150
# The stronger model on hot replies (its monthly cap is llm.task_budgets.closer_hot, default $2)
CLOSER_HOT_MODEL=1

# -- More volume, same domain
EMAIL_CAP_MAX=60
# Dead domains are skipped before sending (free DNS lookup). 0 = off
MX_CHECK=1
# WhatsApp second touch for leads who got the email, stayed silent and have a mobile (you send it from /wa)
WA_TOUCH_PER_DAY=10
WA_TOUCH_AFTER_DAYS=5
# Extra inboxes: list their prefixes, then give each an address and an app password
EMAIL_EXTRA_ACCOUNTS=
EMAIL2_ADDRESS=
EMAIL2_PASSWORD=
EMAIL2_FROM_NAME=
# A new inbox starts at this many a day and climbs by EMAIL_CAP_STEP per day
EMAIL_EXTRA_START=5
# 1 = answer replies automatically; 0 = draft them for your one-tap approval in Telegram
EMAIL_AUTO_REPLY=1
# 1 = hold all new first emails (follow-ups and replies keep working)
EMAIL_PAUSE_COLD=0
