# ─────────────────────────────────────────────────────────────────────
# Autocrat environment — copy to `.env` and fill in. `.env` is gitignored.
# Never put real values in this file or in nexus_config.yaml.
# ─────────────────────────────────────────────────────────────────────

# ── Control plane ──
# High-entropy token for the HUD / REST / WebSocket. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOCRAT_AUTH_TOKEN=
# Comma-separated origins allowed to call the API from a browser
AUTOCRAT_CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000,http://localhost:5173

# ── Runtime ──
# dry_run = external/financial actions are simulated, never sent. live = real.
RUN_MODE=dry_run
# Profile: core (VM, no desktop plugins) | desk (laptop) | full (both, dev)
AUTOCRAT_PROFILE=full
# Extra plugin directories (comma-separated, relative to this repo or absolute)
AUTOCRAT_PLUGIN_PATHS=../autocrat-revenue-plugins/plugins
# SQLite store location (WAL mode)
AUTOCRAT_DB_PATH=.autocrat/autocrat.db
# Set to 0 to skip loading the sentence-transformer intent brain (e.g. on the core VM)
AUTOCRAT_BRAIN=1

# ── Telegram (alerts + approvals) ──
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user IDs allowed to command/approve (Yash, Parth). Get yours from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=
# Optional: restrict to these chat IDs too (e.g. your private founders group). Alerts go here.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── LLM providers ──
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Lead sources (Phase 2) ──
APIFY_TOKEN=
X_BEARER_TOKEN=

# ── WhatsApp Cloud API, Coexistence (Phase 4) ──
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Deposits (Phase 3) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Payment-link base URLs for international clients (USD/GBP/AED)
INFINITY_PAYMENT_LINK_BASE=
WISE_PAYMENT_LINK_BASE=

# ── Demo hosting (Phase 3) ──
BASE_DOMAIN=
CLOUDFLARE_API_TOKEN=
